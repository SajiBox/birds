import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StreamableHTTPServerTransport } from "@modelcontextprotocol/sdk/server/streamableHttp.js";
import { NextRequest, NextResponse } from "next/server";
import { z } from "zod";
import { runGeneration, refreshTask } from "@/lib/generation";
import { createMergeJob, startMergeProcess, checkMergeJob } from "@/lib/merger";
import { listRecentTasks, getTask, insertTask } from "@/lib/turso";

export const runtime = "nodejs";
export const dynamic = "force-dynamic";

let mcpServer: McpServer | null = null;

function getMcpServer() {
  if (!mcpServer) {
    mcpServer = new McpServer({ name: "media-generator-mcp", version: "1.2.0" });
    
    // تسجيل الأدوات (generate_image, generate_video, merge_videos, get_task, list_media)
    // ... (تم تضمين منطق الأدوات في الكود السابق)
    
    mcpServer.tool("generate_image", "توليد صورة...", {
      prompt: z.string(), model: z.string().optional(),
      // ... باقي المعاملات
    }, async (args) => {
      const result = await runGeneration({ model: args.model || "gpt-image-2-6/flare-text-to-image", type: "image", prompt: args.prompt, inputParams: args, waitSeconds: args.wait_seconds });
      return { content: [{ type: "text", text: result.status === "completed" ? `✅ تم التوليد: ${result.urls?.[0]}` : `⏳ قيد المعالجة: ${result.taskId}` }] };
    });

    // ... نفس المنطق لباقي الأدوات
  }
  return mcpServer;
}

export async function POST(req: NextRequest) {
  const server = getMcpServer();
  const transport = new StreamableHTTPServerTransport();
  await server.connect(transport);
  return transport.handleRequest(req);
}